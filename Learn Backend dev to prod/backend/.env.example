# Copy to .env and adjust. All values have safe dev defaults.

APP_NAME=OfficeHub
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Dev uses the machine's local PostgreSQL service (ADR: local PostgreSQL for development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/officehub
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Session lifetime in hours (Phase 03)
SESSION_TTL_HOURS=8