# Copy to .env and adjust. All values have safe dev defaults.

APP_NAME=OfficeHub
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Port 5433: docker-compose maps Postgres there because 5432 is taken locally
DATABASE_URL=postgresql+asyncpg://officehub:officehub@localhost:5433/officehub
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
